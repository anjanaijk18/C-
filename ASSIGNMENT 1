#include <iostream>
using namespace std;

constexpr long long MIN_BALANCE = 5000;
constexpr int PEAK_SURCHARGE = 20;

enum class Zone {
    Inner,
    Middle,
    Outer
};

class FareTable {
public:
    static long long calculateFare(Zone zone, bool peak) {
        long long fare = 0;

        switch (zone) {
            case Zone::Inner:
                fare = 1000;
                break;
            case Zone::Middle:
                fare = 2000;
                break;
            case Zone::Outer:
                fare = 3000;
                break;
            default:
                return -1;
        }

        if (peak) {
            fare += fare * PEAK_SURCHARGE / 100;
        }

        return fare;
    }
};

class SmartCard {
private:
    long long balance;

public:
    SmartCard(long long initialBalance) {
        balance = initialBalance;
    }

    bool canTravel(long long fare) const {
        return fare >= 0 && balance - fare >= MIN_BALANCE;
    }

    bool deduct(long long fare) {
        if (canTravel(fare)) {
            balance -= fare;
            return true;
        }
        return false;
    }

    long long getBalance() const {
        return balance;
    }
};

class Passenger {
private:
    int passengerId;
    bool concessionEligible;

public:
    Passenger(int id, bool eligible)
        : passengerId(id), concessionEligible(eligible) {}

    int getId() const {
        return passengerId;
    }

    bool hasConcession() const {
        return concessionEligible;
    }
};

class Journey {
private:
    Zone zone;
    bool peak;

public:
    Journey(Zone z, bool isPeak) : zone(z), peak(isPeak) {}

    void process(SmartCard& card) const {
        long long fare = FareTable::calculateFare(zone, peak);

        if (card.deduct(fare)) {
            cout << "Journey successful. ";
        } else {
            cout << "Journey denied. ";
        }

        long long balance = card.getBalance();
        cout << "Balance: Rs " << balance / 100 << ".";
        if (balance % 100 < 10) {
            cout << "0";
        }
        cout << balance % 100 << '\n';
    }
};

int main() {
    SmartCard card(10000);
    Passenger passenger(101, true);

    Journey j1(Zone::Inner, false);
    Journey j2(Zone::Outer, true);
    Journey j3(Zone::Middle, false);

    cout << "Passenger ID: " << passenger.getId() << '\n';

    j1.process(card);
    j2.process(card);
    j3.process(card);

    return 0;
} 
